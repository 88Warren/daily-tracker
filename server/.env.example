PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DB_PATH=../data

# ── Google Calendar ───────────────────────────────────────────────────────────
# Create OAuth2 credentials at https://console.cloud.google.com/
# Authorised redirect URI: http://localhost:3001/api/calendar/callback (dev)
#                          https://yourdomain.com/api/calendar/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/calendar/callback

# ── Production only ───────────────────────────────────────────────────────────
# Basic auth to protect the app when hosted on VPS
BASIC_AUTH_USER=your_username
BASIC_AUTH_PASS=your_password
